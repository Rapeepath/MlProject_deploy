# ---------------------------------------------------------------
# Backend (.env) — คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามเครื่อง/บริการจริง
# ---------------------------------------------------------------

# พอร์ตที่ uvicorn ฟัง (Render กำหนด PORT ให้เองอัตโนมัติ ไม่ต้องตั้ง)
PORT=8000

# ตำแหน่งไฟล์โมเดล ถ้าไม่ตั้งจะใช้ backend/models/random_forest_eta.models
# MODEL_PATH=/app/models/random_forest_eta.models
# BASELINE_MODEL_PATH=/app/models/baseline.model
# TEST_CSV_PATH=/app/data/text.csv
# MODELS_DIR=/app/models

# โดเมนที่อนุญาตให้เรียกข้าม origin คั่นด้วย comma, ใส่ * เพื่ออนุญาตทั้งหมด
# โปรดักชันควรระบุโดเมน Vercel ของหน้าบ้านให้ชัด
ALLOWED_ORIGINS=*
# ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:8001

# ระดับ log: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
