# ---------------------------------------------------------------
# Frontend (.env) — คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามสภาพแวดล้อม
# บน Vercel ให้ตั้งค่าเหล่านี้ใน Project Settings > Environment Variables แทน
# ---------------------------------------------------------------

# URL ของ Backend FastAPI (ห้ามมี / ปิดท้าย)
# dev  : http://localhost:8000
# prod : https://eta-prediction-api.onrender.com
BACKEND_API_URL=http://localhost:8000

# วินาทีที่ยอมรอ Backend — Render แพ็กเกจฟรีจะหลับเมื่อไม่มีทราฟฟิก
# การปลุก + โหลดโมเดล 129 MB ใช้เวลาราว 30-60 วินาที
BACKEND_TIMEOUT=60

# ถ้า true: Backend ล่มแล้วหน้าเว็บยังเปิดได้ (สุ่มออเดอร์ได้ แต่ทำนายไม่ได้)
ALLOW_BACKEND_DOWN=true

# ---------------------------------------------------------------
# Django
# ---------------------------------------------------------------
# โปรดักชันต้องสร้างคีย์ใหม่:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-random-50-character-string

# ตั้ง true เฉพาะตอน dev เท่านั้น
DJANGO_DEBUG=true

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.vercel.app,http://localhost:8001,http://127.0.0.1:8001
DJANGO_LOG_LEVEL=INFO
